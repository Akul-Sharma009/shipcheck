# Copy to .env (local) or paste into Streamlit Cloud secrets. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=

# Model IDs are case-sensitive. Check the Token Factory catalog if a call returns 404.
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Repo ingestion limits
MAX_FILES=40

# Cost guardrails
MAX_RUNS_PER_SESSION=5
MAX_UNCACHED_RUNS_PER_DAY=100
# false = never call paid APIs; serve cached example reports only
SHIPCHECK_LIVE=true
